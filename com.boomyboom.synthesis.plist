<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.boomyboom.synthesis</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Applications/BoomyBoom-Biz/run_weekly_synthesis.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Applications/BoomyBoom-Biz</string>

    <!-- 매주 일요일 20:00 (한 주 마감 후 종합) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>20</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Applications/BoomyBoom-Biz/logs/synthesis.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Applications/BoomyBoom-Biz/logs/synthesis.launchd.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
