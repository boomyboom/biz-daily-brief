<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.boomyboom.threads</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Applications/BoomyBoom-Biz/run_threads_draft.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Applications/BoomyBoom-Biz</string>

    <!-- 하루 4회: 09:00 / 13:00 / 17:00 / 21:00 (KST) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Applications/BoomyBoom-Biz/logs/threads.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Applications/BoomyBoom-Biz/logs/threads.launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
