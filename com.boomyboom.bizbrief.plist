<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.boomyboom.bizbrief</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/BoomyBoom Obsidian Agent.app/Contents/MacOS/boomyboom-obsidian-agent</string>
        <string>/Applications/BoomyBoom-Biz/run_daily_brief.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Applications/BoomyBoom-Biz</string>

    <!-- 매일 12:00 (시스템 로컬 타임존 = Mac이 KST면 정오) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Applications/BoomyBoom-Biz/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Applications/BoomyBoom-Biz/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
