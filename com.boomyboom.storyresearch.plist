<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.boomyboom.storyresearch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Applications/BoomyBoom-Biz/run_story_research.sh</string>
    </array>
    <key>WorkingDirectory</key><string>/Applications/BoomyBoom-Biz</string>
    <!-- 토요일 03:00, 유휴 시간에 깊게 리서치 -->
    <key>StartCalendarInterval</key>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
    <key>StandardOutPath</key><string>/Applications/BoomyBoom-Biz/logs/storyresearch.launchd.out.log</string>
    <key>StandardErrorPath</key><string>/Applications/BoomyBoom-Biz/logs/storyresearch.launchd.err.log</string>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
