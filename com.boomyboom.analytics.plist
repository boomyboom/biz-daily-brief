<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.boomyboom.analytics</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Applications/BoomyBoom-Biz/run_threads_analytics.sh</string>
    </array>
    <key>WorkingDirectory</key><string>/Applications/BoomyBoom-Biz</string>
    <!-- 매일 00:30 성과 분석 -->
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>30</integer></dict>
    <key>StandardOutPath</key><string>/Applications/BoomyBoom-Biz/logs/analytics.launchd.out.log</string>
    <key>StandardErrorPath</key><string>/Applications/BoomyBoom-Biz/logs/analytics.launchd.err.log</string>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
