<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.boomyboom.threadstoken</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Applications/BoomyBoom-Biz/refresh_threads_token.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Applications/BoomyBoom-Biz</string>

    <!-- 매일 04:10 토큰 갱신 (장기 토큰 만료 방지) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>10</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Applications/BoomyBoom-Biz/logs/token.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Applications/BoomyBoom-Biz/logs/token.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
