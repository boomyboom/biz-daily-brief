<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.boomyboom.storythread</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Applications/BoomyBoom-Biz/run_story_thread.sh</string>
    </array>
    <key>WorkingDirectory</key><string>/Applications/BoomyBoom-Biz</string>
    <!-- 일요일 10:30, 브리핑이 없는 날 긴 글 -->
    <key>StartCalendarInterval</key>
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    <key>StandardOutPath</key><string>/Applications/BoomyBoom-Biz/logs/storythread.launchd.out.log</string>
    <key>StandardErrorPath</key><string>/Applications/BoomyBoom-Biz/logs/storythread.launchd.err.log</string>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
